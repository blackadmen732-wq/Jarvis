# Copy this file to ".env" and fill it in. Never commit .env.

# Name shown at the top of the app
WEBUI_NAME=Jarvis OS

# Any long random text. Make one with:  openssl rand -hex 32
WEBUI_SECRET_KEY=

# ---------- Provider keys (leave empty if you don't use one) ----------
# OpenRouter: https://openrouter.ai/keys
#   Free models: 50 requests/day, or 1,000/day once you've bought $10 of credit ever.
OPENROUTER_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
# Zhipu GLM: https://z.ai
ZAI_API_KEY=
# More free tiers the router can use (sign up, copy key, paste here):
# NVIDIA NIM: https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# ---------- Router: which model Claude Code really uses ----------
# Format: provider/model. Claude Code's "Opus" and "Sonnet" use MODEL.
MODEL=open_router/openrouter/free
# Claude Code's "Haiku" does small background jobs. Sending it to your own
# local model saves your free cloud requests. Must match a model you downloaded
# (./scripts/add-model.sh uncensored medium).
MODEL_HAIKU=ollama/huihui_ai/qwen3.5-abliterated:9b
REASONING_HAIKU=off
# When the main model is busy or out of free requests, try these in order.
# The local model has no limits, so it's the safety net.
MODEL_FALLBACKS=[{"model":"ollama/huihui_ai/qwen3.5-abliterated:9b","reasoning":"off"}]
